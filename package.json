{
  "name": "sort-sim",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A parcel sorting hub in three.js that moves to its own ambient music: day is clean production, night is a secret party.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "shots": "node scripts/shots.mjs"
  },
  "dependencies": {
    "three": "^0.160.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/three": "^0.160.0",
    "meshoptimizer": "^1.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
